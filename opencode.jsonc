{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-terra",
  // Restrict this project to OpenAI, including future agent selections.
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
  ],
  // Default to low effort to conserve usage; increase only when necessary.
  "agents": {
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra#low",
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra#low",
    },
  },
}
